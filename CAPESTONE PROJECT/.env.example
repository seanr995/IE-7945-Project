# Copy to .env in this folder (/My Drive/CAPESTONE PROJECT/.env). .env is never zipped, logged or printed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Output ceiling per reply. Values below 8000 are raised to 8000 to prevent truncated JSON
# (max_tokens is a cap - billing is per token actually generated).
AGENTIC_MAX_OUTPUT_TOKENS=8000

# Hard budget across ALL runs (persisted in agentic_taxonomy_results/provenance/api_budget.json, never reset).
# Values above 20 are ignored.
AGENTIC_MAX_API_CALLS=20
AGENTIC_MAX_REFINEMENT_ROUNDS=2

# Not used by this runtime (no sampling parameters are ever sent): AGENTIC_TEMPERATURE
