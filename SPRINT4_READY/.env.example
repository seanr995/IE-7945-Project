# Copy to ".env" inside SPRINT4_READY (primary) or the project folder (fallback). SPRINT4_READY/.env wins if both exist. Never share .env.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
GEMINI_MAX_REAL_CALLS=12
GEMINI_MAX_RETRIES=2
GEMINI_MIN_SECONDS_BETWEEN_CALLS=8
# optional output ceiling per reply (a cap)
GEMINI_MAX_OUTPUT_TOKENS=8192
